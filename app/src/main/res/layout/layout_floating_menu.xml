<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center">

    <!-- The small floating cyber circle -->
    <TextView
        android:id="@+id/bubbleIcon"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:background="@android:drawable/dialog_holo_dark_frame"
        android:gravity="center"
        android:text="ANX"
        android:textColor="#00FF66"
        android:textStyle="bold"
        android:textSize="14sp"
        android:elevation="8dp" />

    <!-- Expanded Menu Content -->
    <LinearLayout
        android:id="@+id/expandedMenu"
        android:layout_width="200dp"
        android:layout_height="wrap_content"
        android:background="#111111"
        android:orientation="vertical"
        android:padding="8dp"
        android:visibility="gone"
        android:elevation="8dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ANXHU-HUNTER-V1"
            android:textColor="#00FF66"
            android:textSize="12sp"
            android:textStyle="bold"
            android:gravity="center"
            android:paddingBottom="6dp" />

        <Button
            android:id="@+id/btnGoOfflineClear"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:background="#222222"
            android:text="GO OFFLINE REPORT CLEAR"
            android:textColor="#FF3333"
            android:textSize="10sp" />
    </LinearLayout>

</LinearLayout>