<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Absolute Background Image Layer pointing to your bg_image.png -->
    <ImageView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:src="@drawable/bg_image"
        android:scaleType="centerCrop"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Dark Cyber Gradient Overlay -->
    <View
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#B305090E"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Top Status Indicator -->
    <TextView
        android:id="@+id/statusText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="SYSTEM: SECURE [OFFLINE]"
        android:textColor="#00FF66"
        android:textSize="12sp"
        android:textStyle="bold"
        android:letterSpacing="0.1"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 1. AUTHENTICATION CONTAINER -->
    <LinearLayout
        android:id="@+id/authScreen"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:background="@drawable/cyber_card_bg"
        android:orientation="vertical"
        android:padding="24dp"
        android:visibility="visible"
        android:elevation="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ANXHU-HUNTER V1"
            android:textColor="#00FF66"
            android:textSize="20sp"
            android:textStyle="bold"
            android:gravity="center"
            android:letterSpacing="0.15"
            android:paddingBottom="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="SECURE ACCESS GATEWAY"
            android:textColor="#888888"
            android:textSize="10sp"
            android:gravity="center"
            android:letterSpacing="0.2"
            android:paddingBottom="24dp" />

        <EditText
            android:id="@+id/keyInput"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/cyber_input_bg"
            android:hint="ENTER AUTHORIZATION KEY"
            android:textColor="#00FF66"
            android:textColorHint="#444444"
            android:textSize="13sp"
            android:inputType="textPassword"
            android:gravity="center"
            android:letterSpacing="0.05"
            android:padding="12dp" />

        <Button
            android:id="@+id/btnVerifyKey"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/cyber_button_bg"
            app:backgroundTint="@null"
            android:text="AUTHENTICATE"
            android:textColor="#000000"
            android:textSize="14sp"
            android:textStyle="bold"
            android:letterSpacing="0.1" />
    </LinearLayout>

    <!-- 2. MAIN DASHBOARD CONTAINER -->
    <LinearLayout
        android:id="@+id/mainDashboard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <Button
            android:id="@+id/btnRequestPermission"
            android:layout_width="220dp"
            android:layout_height="44dp"
            android:background="@drawable/cyber_input_bg"
            app:backgroundTint="@null"
            android:text="GRANT SHIZUKU"
            android:textColor="#00FF66"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.1"
            android:layout_marginBottom="20dp" />

        <Button
            android:id="@+id/btnInject"
            android:layout_width="280dp"
            android:layout_height="64dp"
            android:background="@drawable/cyber_button_bg"
            app:backgroundTint="@null"
            android:text="ACTIVATE PROXY"
            android:textColor="#000000"
            android:textSize="16sp"
            android:textStyle="bold"
            android:letterSpacing="0.15"
            android:elevation="12dp" />
    </LinearLayout>

    <!-- Bottom Terminal Logs -->
    <TextView
        android:id="@+id/logText"
        android:layout_width="0dp"
        android:layout_height="100dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="20dp"
        android:background="#CC000000"
        android:textColor="#00FF66"
        android:textSize="10sp"
        android:text="[SYSTEM READY]\n"
        android:padding="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>