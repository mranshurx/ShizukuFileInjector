<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center_horizontal">

        <!-- App Branding Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ANXHU-HUNTER-V1"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#00E676"
            android:layout_marginBottom="16dp" />

        <!-- Shizuku Status -->
        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Shizuku: not checked"
            android:textColor="#B0BEC5"
            android:textSize="14sp"
            android:gravity="center"
            android:paddingBottom="16dp" />

        <!-- Grant Permission Button -->
        <Button
            android:id="@+id/btnRequestPermission"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Grant Shizuku Permission"
            android:backgroundTint="#37474F"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="24dp" />

        <!-- Divider Line -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#333333"
            android:layout_marginBottom="24dp" />

        <!-- ACTIVATE PROXY Button -->
        <Button
            android:id="@+id/btnInject"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="ACTIVATE PROXY"
            android:textSize="16sp"
            android:textStyle="bold"
            android:backgroundTint="#00C853"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="16dp" />

        <!-- OFFLINE MODE Button -->
        <Button
            android:id="@+id/btnOfflineMode"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="OFFLINE MODE"
            android:textSize="16sp"
            android:textStyle="bold"
            android:backgroundTint="#D32F2F"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="16dp" />

        <!-- Run Diagnostics Button -->
        <Button
            android:id="@+id/btnDiagnostics"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Run Diagnostics"
            android:backgroundTint="#263238"
            android:textColor="#B0BEC5"
            android:layout_marginBottom="24dp" />

        <!-- Logs Box -->
        <TextView
            android:id="@+id/logText"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:fontFamily="monospace"
            android:textSize="12sp"
            android:textColor="#90CAF9"
            android:background="#1E1E1E"
            android:padding="12dp"
            android:scrollbars="vertical"
            android:text="Logs will appear here..." />

    </LinearLayout>
</ScrollView>