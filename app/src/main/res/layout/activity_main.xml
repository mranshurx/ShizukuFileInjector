<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0A0A"
    android:orientation="vertical"
    android:padding="16px">

    <!-- Status Bar -->
    <TextView
        android:id="@+id/statusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Shizuku: Checking..."
        android:textColor="#00FF66"
        android:textSize="14sp"
        android:textStyle="bold"
        android:paddingBottom="8dp" />

    <!-- 1. Authentication Screen Container (Visible on launch) -->
    <LinearLayout
        android:id="@+id/authScreen"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="visible">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ANXHU-HUNTER-V1 | AUTHENTICATION"
            android:textColor="#00FF66"
            android:textSize="16sp"
            android:textStyle="bold"
            android:paddingBottom="12dp" />

        <EditText
            android:id="@+id/keyInput"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="#1A1A1A"
            android:hint="Enter Key..."
            android:textColor="#FFFFFF"
            android:textColorHint="#555555"
            android:textSize="14sp"
            android:inputType="text"
            android:padding="8dp" />

        <Button
            android:id="@+id/btnVerifyKey"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:background="#00FF66"
            android:text="VERIFY KEY"
            android:textColor="#000000"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 2. Main Dashboard Container (Hidden until key is verified) -->
    <LinearLayout
        android:id="@+id/mainDashboard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <Button
            android:id="@+id/btnRequestPermission"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Grant Shizuku Permission"
            android:background="#222222"
            android:textColor="#00FF66"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnInject"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="ACTIVATE PROXY"
            android:background="#00FF66"
            android:textColor="#000000"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Console Logs -->
    <TextView
        android:id="@+id/logText"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="16dp"
        android:background="#050505"
        android:textColor="#00FF66"
        android:textSize="11sp"
        android:text="[System Initialized]\n"
        android:padding="8dp" />

</LinearLayout>